# ── StockScope environment variables ─────────────────────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# All settings here override the defaults in Backend/config/settings.py.

# ── Django ────────────────────────────────────────────────────────────────────

# Generate a real secret key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts (used by Django)
# Example production value: myapp.example.com,www.myapp.example.com
ALLOWED_HOSTS=*

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────

DB_NAME=stockscope
DB_USER=postgres
DB_PASSWORD=changeme
# DB_HOST is overridden to "db" by docker-compose; leave as localhost for local dev
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Frontend / CORS ───────────────────────────────────────────────────────────

# URL the browser uses to reach the Django API.
# In Docker: the browser hits your host machine, so keep localhost here.
VITE_API_BASE_URL=http://localhost:8000/api

# URL Django uses for CORS allow-list (must match what the browser sends)
FRONTEND_URL=http://localhost:3000

# ── Port mapping (docker-compose only) ────────────────────────────────────────

BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── News categorisation ML settings ──────────────────────────────────────────

# Sentence-Transformers model name (downloaded on first use)
CATEGORIZATION_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Hybrid scoring weights (must sum to 1.0)
CATEGORIZATION_EMBEDDING_WEIGHT=0.60
CATEGORIZATION_KEYWORD_WEIGHT=0.40

# Minimum confidence required to attach a company tag automatically
CATEGORIZATION_THRESHOLD=0.65

# Minimum score for semantic-only matching (no keyword evidence)
CATEGORIZATION_SEMANTIC_ONLY_THRESHOLD=0.75

# Floor below which a match is flagged for human review instead of auto-tagged
CATEGORIZATION_SEMANTIC_REVIEW_FLOOR=0.60

# Sentiment analysis method (currently only "lexicon" is implemented)
SENTIMENT_METHOD=lexicon
